APP_NAME=Annvitra WhatsApp Ordering Bot
DATABASE_URL=sqlite:///./annvitra.db

# demo or google_sheets
MENU_SOURCE=demo

# Twilio credentials from your Twilio Console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP_NUMBER=whatsapp:+923000000000
PUBLIC_BASE_URL=https://your-public-https-domain.example

# Optional Google Sheets menu source
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=Menu
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Payment instructions shown to customer for manual UPI
UPI_PAYMENT_INSTRUCTIONS=Please transfer the exact amount to the business UPI account and wait for payment verification.
UPI_ID_OR_NAME=Configure the real business UPI ID here

# Use true after correctly configuring PUBLIC_BASE_URL and Twilio webhook
TWILIO_VALIDATE_SIGNATURE=false

# Order reservation hold in minutes (expiry cleanup is not implemented in this MVP)
ORDER_RESERVATION_MINUTES=30
